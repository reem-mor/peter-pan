# Copy to .env (gitignored) and fill in. Never commit .env.
# Environment: mirage (simulation) | staging (validation) | production (read-only + approvals)
PP_ENV=mirage
PP_USAGE_LOG_PATH=usage.jsonl

# Mesh application auth (X-PP-Token). Unset/empty = open fixture path.
# Required for EC2 demo hardening — held by n8n / Next.js BFF only, never the browser.
# PP_API_TOKEN=

# LLM — off | anthropic | bedrock (fixture-first default: off)
# PP_LLM=off
# PP_BEDROCK_MODEL_ID=anthropic.claude-sonnet-4-5-20250929-v1:0
# AWS_REGION=us-east-1
# ANTHROPIC_API_KEY=

# Retrieval — lexical | pinecone (standalone Pinecone; not Bedrock KB)
# PP_RAG_BACKEND=lexical
# PINECONE_API_KEY=
# VOYAGE_API_KEY=
# PP_PINECONE_INDEX=peter-pan-knowledge

# Predictor — floor | torch
# PP_PREDICTOR=floor

# Guardrails — regex | nemo
# PP_GUARDRAILS=regex
