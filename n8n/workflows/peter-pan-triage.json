{
  "name": "PETER PAN — Triage (v3)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "peter-pan-intake",
        "responseMode": "responseNode",
        "authentication": "headerAuth"
      },
      "name": "Alert Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "notes": "headerAuth: bind an n8n Header Auth credential (e.g. X-PP-Intake-Key) before activating. Unauthenticated intake lets anyone spend LLM tokens with attacker-controlled alert text."
    },
    {
      "parameters": {
        "jsCode": "// Normalize the inbound payload into a schema-valid Alert. The input rail\n// only reads title/description, but /story validates the full Alert schema —\n// fill required fields so a rail-passing alert can't 422 downstream.\nconst b = $('Alert Webhook').item.json.body ?? {};\nreturn [{ json: {\n  id: b.id ?? ('n8n-' + $execution.id),\n  source: b.source ?? 'n8n-webhook',\n  title: b.title ?? '',\n  description: b.description ?? '',\n  received_at: b.received_at ?? new Date().toISOString()\n} }];"
      },
      "name": "Normalize Alert",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [180, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.PP_GUARDRAILS_BASE }}/check/input",
        "sendBody": true,
        "bodyParameters": { "parameters": [{ "name": "text", "value": "={{ $json.title }} {{ $json.description }}" }] }
      },
      "name": "Guardrails Input",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [360, 0],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "leftValue": "={{ $json.passed }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "true" }
            }
          ],
          "combinator": "and"
        }
      },
      "name": "Input Passed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [540, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.PP_AGENT_BASE }}/story",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $('Normalize Alert').item.json }}"
      },
      "name": "Build Story",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [720, -80],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.PP_GUARDRAILS_BASE }}/check/output",
        "sendBody": true,
        "bodyParameters": { "parameters": [{ "name": "text", "value": "={{ JSON.stringify($json) }}" }] }
      },
      "name": "Guardrails Output",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [900, -80],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "leftValue": "={{ $json.passed }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "true" }
            }
          ],
          "combinator": "and"
        }
      },
      "name": "Output Passed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1080, -80]
    },
    {
      "parameters": { "respondWith": "json", "responseBody": "={{ $('Build Story').item.json }}" },
      "name": "Respond Story",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1260, -160]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"flagged_for_human_review\": true, \"reason\": $('Guardrails Output').item.json.reason ?? \"output rail rejected the story\" } }}",
        "options": { "responseCode": 200 }
      },
      "name": "Respond Flagged",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1260, 0]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"rejected\": true, \"reason\": $json.reason } }}",
        "options": { "responseCode": 422 }
      },
      "name": "Respond Rejected",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [720, 120]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"error\": true, \"stage\": $prevNode.name, \"detail\": \"upstream service unavailable or returned an error\" } }}",
        "options": { "responseCode": 502 }
      },
      "name": "Respond Error",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [720, 260]
    }
  ],
  "connections": {
    "Alert Webhook": { "main": [[{ "node": "Normalize Alert", "type": "main", "index": 0 }]] },
    "Normalize Alert": { "main": [[{ "node": "Guardrails Input", "type": "main", "index": 0 }]] },
    "Guardrails Input": {
      "main": [
        [{ "node": "Input Passed?", "type": "main", "index": 0 }],
        [{ "node": "Respond Error", "type": "main", "index": 0 }]
      ]
    },
    "Input Passed?": {
      "main": [
        [{ "node": "Build Story", "type": "main", "index": 0 }],
        [{ "node": "Respond Rejected", "type": "main", "index": 0 }]
      ]
    },
    "Build Story": {
      "main": [
        [{ "node": "Guardrails Output", "type": "main", "index": 0 }],
        [{ "node": "Respond Error", "type": "main", "index": 0 }]
      ]
    },
    "Guardrails Output": {
      "main": [
        [{ "node": "Output Passed?", "type": "main", "index": 0 }],
        [{ "node": "Respond Error", "type": "main", "index": 0 }]
      ]
    },
    "Output Passed?": {
      "main": [
        [{ "node": "Respond Story", "type": "main", "index": 0 }],
        [{ "node": "Respond Flagged", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": { "executionOrder": "v1" }
}
